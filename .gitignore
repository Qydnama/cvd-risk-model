# Python and tooling
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# R and renv local state
.RData
.Rhistory
.Ruserdata
renv/library/
renv/staging/
renv/local/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local environment and logs
.env
.env.*
!.env.example
*.log

# Source and derived research data must never be committed.
data/raw/**
data/interim/**
data/processed/**
!data/raw/**/
!data/interim/**/
!data/processed/**/
!data/raw/**/.gitkeep
!data/interim/**/.gitkeep
!data/processed/**/.gitkeep

# Trained binary artifacts are reproducible outputs, not source files.
artifacts/**/*.joblib
artifacts/**/*.pkl
artifacts/**/*.pickle
artifacts/**/*.bin
artifacts/**/*.onnx
artifacts/**/oof_predictions.parquet
artifacts/quarantine/**

# The explicitly frozen minimal pipeline and its components are versioned.
!artifacts/minimal_v1/full_development_pipeline.joblib
!artifacts/minimal_v1/preprocessing.joblib
!artifacts/minimal_v1/estimator.joblib
!artifacts/minimal_v1/calibrator.joblib

# Notebook execution state
.ipynb_checkpoints/
